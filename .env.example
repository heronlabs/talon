# talon configuration: /etc/talon/.env, mode 600. `talon setup` writes it.
# Format: KEY=VALUE, one per line. Lines starting with # are ignored.

# Webhook where the agent sends its report, with the hostname of the machine as its host. Optional: no URL means no webhook, and setup does not ask for the token; no token means no Authorization header.
WEBHOOK_URL=
WEBHOOK_TOKEN=

# AWS credentials of this host's own IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# How often the agent sends a report.
INTERVAL_REPORT=10m
