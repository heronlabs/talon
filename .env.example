# talon configuration: /etc/talon/.env, mode 600. `talon setup` writes it.
# Format: KEY=VALUE, one per line. Lines starting with # are ignored.

# CMS: where the agent reads its manifest and sends its report.
CMS_URL=
CMS_AGENT_TOKEN=
CMS_AGENT_HOST_NAME=

# Easypanel API on this host.
EASYPANEL_URL=http://127.0.0.1:3000
EASYPANEL_TOKEN=

# AWS credentials of this host's own IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# How often the agent reconciles Easypanel and sends a report.
INTERVAL_RECONCILE=5m
INTERVAL_REPORT=10m

# Public half of the talon-deploy SSH key; setup adds it to root's authorized_keys,
# where it can only upgrade talon. The CD upgrades talon on this host through it.
# Empty: no push upgrades on this host.
DEPLOY_SSH_PUBLIC_KEY=
