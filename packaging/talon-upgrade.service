[Unit]
Description=Upgrade talon from its apt repository
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/apt/sources.list.d/talon.list

[Service]
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/bin/apt-get -qq -o Dir::Etc::sourcelist=sources.list.d/talon.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 update
ExecStart=/usr/bin/apt-get -qq -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install --only-upgrade talon
