#!/usr/bin/env bash
set -euo pipefail

git diff --cached --quiet -- '*.go' go.mod go.sum && exit 0

unformatted=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.go' | xargs -0 gofmt -l)
[ -z "$unformatted" ] || { echo "gofmt: $unformatted" >&2; exit 1; }

CGO_ENABLED=0 go build ./...
go vet ./...
go test ./... >/dev/null
